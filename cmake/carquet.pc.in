prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: carquet
Description: Pure C library for reading and writing Apache Parquet files
URL: https://github.com/Vitruves/carquet
Version: @PROJECT_VERSION@

Cflags: -I${includedir}
Libs: -L${libdir} -lcarquet
Libs.private: @CARQUET_PC_PRIVATE_LIBS@
