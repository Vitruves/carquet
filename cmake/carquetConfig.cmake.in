@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# carquet links these as PRIVATE; for a static library they propagate to
# consumers, so the imported targets must be resolvable here.
if(@CARQUET_NEEDS_THREADS@)
    find_dependency(Threads)
endif()
if(@CARQUET_NEEDS_OPENMP@)
    find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/carquetTargets.cmake")

check_required_components(carquet)
